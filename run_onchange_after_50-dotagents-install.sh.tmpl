#!/usr/bin/env bash
#
# Installs the dotagents CLI (https://github.com/getsentry/dotagents) and
# installs the global agent skills declared in ~/.agents/agents.toml.
#
# run_onchange_: re-runs whenever this rendered script changes, which includes
# the hash of agents.toml below, so editing the skill list triggers a reinstall.
#
# agents.toml hash: {{ include "dot_agents/agents.toml" | sha256sum }}
# dotagents-revision: 1

set -euo pipefail

log()  { printf '\033[1;34m[dotagents]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[dotagents]\033[0m %s\n' "$*" >&2; }

DOTAGENTS_PACKAGE="@sentry/dotagents"

if ! command -v mise >/dev/null 2>&1; then
    if [[ -x "$HOME/.local/bin/mise" ]]; then
        export PATH="$HOME/.local/bin:$PATH"
    else
        warn "mise not found; cannot install dotagents. Re-run after the package install script."
        exit 0
    fi
fi

# Same supply-chain guard as the Pi install script.
log "Installing/updating ${DOTAGENTS_PACKAGE} via mise node@lts ..."
mise exec node@lts -- npm install -g --min-release-age=3 "${DOTAGENTS_PACKAGE}"
mise reshim || true

# Global scope (~/.agents/) is dotagents' default. Run from $HOME so it never
# picks up a project's agents.toml by accident.
log "Installing skills from ~/.agents/agents.toml ..."
cd "$HOME"
mise exec node@lts -- dotagents --global install
